{
  "name": "nirnlab-ui-platform",
  "version-semver": "4.0.0",
  "description": "UI platform for Skyrim, including CEF (Chromium Embedded Framework) integration and more",
  "homepage": "https://github.com/kkEngine/NirnLabUIPlatform",
  "license": "MIT",
  "supports": "windows & x64",
  "dependencies": [
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "cef-prebuilt",
    {
      "name": "directxtk",
      "platform": "windows"
    },
    "palsigslot",
    "spdlog",
    "commonlibsse-ng",
    "nlohmann-json"
  ],
  "features": {
    "skyrim-se": {
      "description": "Build for Skyrim SE 1.5.97 instead of Skyrim AE 1.7.104",
      "dependencies": [
        {
          "name": "commonlibsse-ng",
          "features": [
            "se"
          ]
        }
      ]
    }
  }
}
